# Copie para .env (o docker compose lê sozinho) e troque os valores.
# Gere segredos com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Senha do Postgres. Use só letras, números, - e _ (ela vai dentro da URL do banco).
POSTGRES_PASSWORD=troque-esta-senha
# Chave que assina o login. Pelo menos 32 caracteres.
JWT_SECRET=troque-este-segredo-por-um-com-pelo-menos-32-caracteres

# Opcionais
# ENVIRONMENT=production
# WEB_PORT=8080
# DB_PORT=5432
